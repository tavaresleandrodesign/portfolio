# SPA fallback: this site uses React Router (client-side routing), so every
# route besides "/" (ex: /sobre, /projects/creditas-auto) doesn't exist as a
# real file on the server. Without this rewrite, accessing those URLs
# directly (or a search engine crawling them) returns 404 on Hostinger/Apache.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files as-is (images, CSS, JS, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve real directories as-is only if they have their own index file.
  # Without this check, a route like /projects/creditas-auto — which is also
  # a real folder of gallery images with no index.html inside — would match
  # as a directory and Apache would try (and fail, with a 403) to list it,
  # instead of falling through to the SPA below.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # Everything else falls back to index.html so React Router can handle it
  RewriteRule ^ index.html [L]
</IfModule>

# Basic caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
